# ============================================================
# Academic Research Flow - 环境变量配置
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ============================================================

# --- DeepSeek API (必需) ---
# 注册地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- OpenAlex (可选，建议填写邮箱以避免限流) ---
# OpenAlex 礼貌池: https://docs.openalex.org/api-links/getting-started/polite-pool
OPENALEX_MAILTO=your_email@example.com

# --- Semantic Scholar API (可选，建议填写以提高限流) ---
# 注册地址: https://api.semanticscholar.org/
SEMANTIC_SCHOLAR_API_KEY=

# --- easyScholar API (需注册获取 secretKey) ---
# 注册地址: https://www.easyscholar.cc
# 登录后 → 我的信息 → 开放接口 → 复制 secretKey
EASYSCHOLAR_SECRET_KEY=your_secret_key_here
